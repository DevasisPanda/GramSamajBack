# ==============================================================================
# AIRD Management System (Backend) — Environment Configuration
# ==============================================================================

# Database Connection (MySQL / TiDB / PlanetScale)
DATABASE_URL=mysql://root:password@localhost:3306/aird_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
ADMIN_EMAIL=admin@airdup.com
ADMIN_SEED_PASSWORD=admin123

# Server & Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://airdup.com

# Payment Gateway (Razorpay — Optional for local testing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Delivery (Resend — Optional; logs to console if unset)
RESEND_API_KEY=
EMAIL_FROM=AIRD Trust <no-reply@airdup.com>

# Cloud Media Storage (Cloudinary — Optional)
CLOUDINARY_URL=
